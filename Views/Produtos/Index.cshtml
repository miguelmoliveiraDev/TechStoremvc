@* Passo 3 - Criar views*@
@model List<TechStoremvc.Models.Produto>

    @{
        ViewData["Title"] = "Produtos";
    }

<h1>
    Lista de produtos
</h1>
<table class= table table-striped>
    <thead>
        @* Cabeçalho da tabela *@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Estoque</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var produto in Model)
        {
            <tr>
            <td>@produto.Id</td>
            <td>@produto.Nome</td>
            <td>R$ @produto.Preco.ToString("F2")</td>
            <td>@produto.Estoque</td>
            <td>
                <button class="btn btn-primary">Detalhes</button>
            </td>
            </tr>
        }
    </tbody>
</table>