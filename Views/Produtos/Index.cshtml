@* Passo 3 - Criar views*@
@model List<TechStoremvc.Models.Produto>

    @{
        ViewData["Title"] = "Produtos";
    }

<h1>
    Lista de produtos
</h1>
<table class= table table-striped>
    <thead>
        @* Cabeçalho da tabela *@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Estoque</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var produto in Model)
        {
            <tr>
            <td>@produto.Id</td>
            <td>@produto.Nome</td>
            <td>R$ @produto.Preco.ToString("F2")</td>
            <td>@produto.Estoque</td>
            <td>
                <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-primary"> Detalhes </a>

                <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-warning">
                    Editar</a>

                <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-danger">
                    Excluir</a>

                 <a asp-action="Create" asp-route-id="@produto.Id" class="btn btn-success">
                    Criar</a>
            </td>
            </tr>
        }
    </tbody>
</table>
