@* Passo 3 - Criar views*@
@model List<TechStoremvc.Models.Categoria>

    @{
        ViewData["Title"] = "Categorias";
    }

<h1>
    Lista de categorias
</h1>
<table class= table table-striped>
    <thead>
        @* Cabeçalho da tabela *@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Ativa</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var categoria in Model)
        {
            <tr>
            <td>@categoria.Id</td>
            <td>@categoria.Nome</td>
            <td>@categoria.Descricao</td>
            <td>@categoria.Ativa</td>
            <td>
                <button class="btn btn-primary">Descrição</button>
            </td>
            </tr>
        }
    </tbody>
</table>