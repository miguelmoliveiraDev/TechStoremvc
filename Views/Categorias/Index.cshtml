@* Passo 3 - Criar views*@
@model List<TechStoremvc.Models.Categoria>


@{
    ViewData["Title"] = "Categoria";
}

<div class="d-flex justify-content-between
    align-items-center mb-3">
    <h1>Categoria</h1>

    <a asp-action="Create" class="btn btn-success">
        Nova categoria
    </a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrição</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Categoria categoria in Model)
            {
                <tr>
                    <td>@categoria.Nome</td>
                    <td>@categoria.Descricao</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-primary btn-sm">
                            Detalhes
                        </a>

                        <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                        <!-- Os botões serão adicionados
                             nas próximas etapas. -->
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>